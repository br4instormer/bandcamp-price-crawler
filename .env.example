# The crawler resolves every parameter through the cascade: a CLI flag beats
# a value here, a value here beats a real environment variable, and only
# then the built-in default applies. See `crawler --help` for the flags.

# Number of queue workers processing the URL list
CONCURENT_DOWNLOADS=5

# Bounds (milliseconds) of the random pause before every request
DELAY_MIN=300
DELAY_MAX=700

# Cap on simultaneous HTTP requests; defaults to CONCURENT_DOWNLOADS
#MAX_CONCURRENT_REQUESTS=5

# How many times a failed request is retried (429/5xx/network errors)
#RETRIES=50

# Exponential retry delay bounds (milliseconds)
#RETRY_BASE_DELAY_MS=1000
#RETRY_MAX_DELAY_MS=60000

# Per-request HTTP timeout (milliseconds)
#HTTP_TIMEOUT_MS=30000

# Custom User-Agent header
#USER_AGENT=Mozilla/5.0 ...

# Proxy pool: a comma-separated list (http, https, socks5, socks5h;
# user:password@ for credentials) or a path to a file with one proxy per
# line. Empty / unset = direct connection. A proxy fails PROXY_ERROR_BUDGET
# times in a row -> blocked until the run restarts; all blocked -> direct.
#HTTP_PROXIES=socks5://user:password@proxy.example:1080
#HTTP_PROXIES=/var/tmp/proxies.txt

# Consecutive failed attempts through one proxy before it is blocked
#PROXY_ERROR_BUDGET=5

# Proxy-only mode: true/on/1 forbids the direct connection — the crawl
# refuses to start unless HTTP_PROXIES holds a list or a file. false/off/0
# (default) = dead proxies fall back to the direct connection.
#PROXY_ONLY=false

# Challenge solver: base URL of a FlareSolverr-compatible service (e.g. a
# local trawl). Empty = the rod solver works alone.
#FLARESOLVERR_URL=http://trawl.local

# Per-request solving budget of the FlareSolverr service (milliseconds)
#FLARESOLVERR_MAX_TIMEOUT_MS=60000

# Chrome/chromium binary for the rod solver. Empty = autodetect a system
# browser first; a managed download starts lazily only as the last resort.
#CHROME_PATH=/usr/bin/chromium

# Log level: debug, info, warn, error
#LOG_LEVEL=info

# Full-screen progress dashboard: auto (on when stdout is a terminal), on, off
#PROGRESS=auto

# SonarQube scanner target (see scripts/sonar-scan.sh)
#SONAR_HOST_URL=https://sonar.example.com
#SONAR_TOKEN=
